# Credenciales locales para Docker Compose y los microservicios.
# Copia este archivo como .env y sustituye todos los valores de ejemplo.
MONGO_USER=change-me
MONGO_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000

# Opcionales: estos son los valores por defecto de desarrollo.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
